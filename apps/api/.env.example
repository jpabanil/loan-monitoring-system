# Local development values. Never commit a real .env.
NODE_ENV=development
PORT=4000
# Superuser connection used only by `db:setup` to create roles and databases (dev/test).
ADMIN_DATABASE_URL=postgres://localhost:5432/postgres
# Owner role: runs migrations (creates tables, grants).
MIGRATION_DATABASE_URL=postgres://lms_owner:lms_owner_dev@localhost:5432/lms_dev
# Application role: INSERT/SELECT only on ledger_entries and audit_logs.
DATABASE_URL=postgres://lms_app:lms_app_dev@localhost:5432/lms_dev
# At least 32 random characters. Generate: openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# 32 bytes, base64. Encrypts TOTP secrets. Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0zMi1ieXRlcyE=
CORS_ORIGIN=http://localhost:3000
# pg-boss queue connection: needs a role that may create the pgboss schema (dev: the owner role).
JOBS_DATABASE_URL=postgres://lms_owner:lms_owner_dev@localhost:5432/lms_dev
